{
  "name": "@bquery/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint rules for bQuery.js: catch top-level $() calls, unsafe trusted HTML, unscoped component reactivity, untracked signal reads and root-entry imports.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:export-map": "bun scripts/generate-export-map.mjs",
    "check:export-map": "bun scripts/generate-export-map.mjs --check"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "bquery",
    "signals",
    "web-components",
    "lint"
  ],
  "author": "Jonas Pfalzgraf <support@josunlp.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bQuery/eslint-plugin.git"
  },
  "homepage": "https://github.com/bQuery/eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/bQuery/eslint-plugin/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@bquery/bquery": "^1.17.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
